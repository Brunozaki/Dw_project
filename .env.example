# Gere o .env com scripts/create-env.sh. Os valores "gerar" são substituídos
# por segredos aleatórios; o .env nunca deve ser versionado.

# Banco de metadados do Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_PASSWORD=gerar

# Data warehouse
DW_USER=dw_admin
DW_DB=dw_logistica
DW_PASSWORD=gerar
DW_PORT=5433

# Airflow
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=gerar
AIRFLOW_JWT_SECRET=gerar
FERNET_KEY=gerar
